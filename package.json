{
  "name": "deposit-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Веб-калькулятор выплат по банковскому вкладу",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bem": "node scripts/check-bem.mjs",
    "docs:screens": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "decimal.js": "10.6.0",
    "vue": "3.5.43",
    "vue-chartjs": "5.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
